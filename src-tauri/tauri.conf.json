{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ORD Helper",
  "version": "0.1.0",
  "identifier": "com.pnc.ord-helper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "ORD Helper",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
